    "pairing.unpaired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired. Generate a key and enter it on the PC to pair. The key is never sent over the USB connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ペアリングです。キーを生成し、PC 側に手入力するとペアリングできます。キーは USB 通信では流れません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gekoppelt. Erzeugen Sie einen Schlüssel und geben Sie ihn am PC ein, um zu koppeln. Der Schlüssel wird nie über die USB-Verbindung übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non jumelé. Générez une clé et saisissez-la sur le PC pour effectuer le jumelage. La clé n'est jamais transmise via la connexion USB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin emparejar. Genera una clave e introdúcela en el PC para emparejar. La clave nunca se envía por la conexión USB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pareado. Gere uma chave e digite-a no PC para parear. A chave nunca é enviada pela conexão USB."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링되지 않았습니다. 키를 생성하고 PC에서 입력하면 페어링할 수 있습니다. 키는 USB 연결로 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配对。生成密钥并在 PC 上输入即可配对。密钥绝不会通过 USB 连接传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配對。產生金鑰並在 PC 上輸入即可配對。金鑰絕不會透過 USB 連線傳輸。"
          }
        }
      }
    },
