    "credentials.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No credentials yet. They are created when you register on a WebAuthn-enabled site."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ資格情報がありません。WebAuthn 対応サイトの登録フローから作成されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Zugangsdaten. Sie werden bei der Registrierung auf einer WebAuthn-Website erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun identifiant pour le moment. Ils sont créés lors de l'inscription sur un site compatible WebAuthn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay credenciales. Se crean al registrarte en un sitio compatible con WebAuthn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há credenciais. Elas são criadas ao se registrar em um site compatível com WebAuthn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 자격 증명이 없습니다. WebAuthn 지원 사이트에 등록하면 생성됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无凭据。在支持 WebAuthn 的网站注册时将创建凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無憑據。在支援 WebAuthn 的網站註冊時將建立憑據。"
          }
        }
      }
    },
