    "settings.credentials.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credential was not deleted because Face ID confirmation didn't succeed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID で確認できなかったため、削除しませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey wurde nicht gelöscht, da die Face-ID-Bestätigung nicht erfolgreich war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant n'a pas été supprimé car la confirmation Face ID a échoué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La credencial no se eliminó porque la confirmación con Face ID no se completó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial não foi excluída porque a confirmação com Face ID não foi concluída."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 확인에 실패하여 자격 증명이 삭제되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 Face ID 验证未成功，凭据未被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於 Face ID 驗證未成功，憑據未被刪除。"
          }
        }
      }
    },
    "settings.credentials.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credential for “%@” and its private key will be permanently deleted. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の資格情報と秘密鍵が完全に削除されます。この操作は元に戻せません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Passkey für „%@“ und sein privater Schlüssel werden endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identifiant pour « %@ » et sa clé privée seront définitivement supprimés. Opération irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La credencial de «%@» y su clave privada se eliminarán para siempre. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial de “%@” e sua chave privada serão excluídas permanentemente. Isso não pode ser desfeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'의 자격 증명과 개인 키가 완전히 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的凭据及其私钥将被永久删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的憑據及其私鑰將被永久刪除。此操作無法復原。"
          }
        }
      }
    },
