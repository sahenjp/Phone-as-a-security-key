    "approval.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't recognize this request, deny it. Once you approve, Face ID will be requested next. This request is denied automatically after 60 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心当たりのないリクエストは拒否してください。承認すると続けて Face ID が求められます。60 秒で自動的に拒否されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie diese Anfrage nicht zuordnen können, lehnen Sie sie ab. Nach Ihrer Genehmigung wird Face ID angefordert. Die Anfrage wird nach 60 Sekunden automatisch abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ne reconnaissez pas cette demande, refusez-la. Après votre approbation, Face ID sera demandé. La demande est refusée automatiquement après 60 secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no reconoces esta solicitud, recházala. Después de aprobarla, se te pedirá Face ID. La solicitud se rechaza automáticamente después de 60 segundos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não reconhecer esta solicitação, negue-a. Depois de aprovar, o Face ID será solicitado. A solicitação é negada automaticamente após 60 segundos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인이 요청한 것이 아니면 거부하세요. 승인하면 다음에 Face ID가 요청됩니다. 이 요청은 60초 후 자동으로 거부됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这不是您发起的请求，请拒绝它。您批准后，接下来会要求 Face ID。此请求将在 60 秒后自动被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果這不是您發起的要求，請拒絕它。您核准後，接下來會要求 Face ID。此要求將在 60 秒後自動被拒絕。"
          }
        }
      }
    },
