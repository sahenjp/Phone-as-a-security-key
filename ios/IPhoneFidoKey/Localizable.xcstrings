    "note.keep_foreground": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this app on screen while authenticating. If it moves to the background, the connection stops. Approval always requires the button on this screen and Face ID; connecting the USB cable alone never approves anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証中はこのアプリを画面に表示したままにしてください。バックグラウンドに移ると接続が止まります。承認は必ずこの画面のボタンと Face ID が必要で、USB 接続だけでは承認されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie diese App während der Authentifizierung im Vordergrund. Wechselt sie in den Hintergrund, stoppt die Verbindung. Eine Genehmigung erfordert immer die Schaltfläche auf diesem Bildschirm und Face ID; das bloße Anschließen des USB-Kabels genehmigt nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cette app au premier plan pendant l'authentification. Si elle passe en arrière-plan, la connexion s'arrête. L'approbation exige toujours le bouton sur cet écran et Face ID ; brancher le câble USB seul n'approuve jamais rien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén esta app en primer plano mientras te autenticas. Si pasa a segundo plano, la conexión se detiene. La aprobación siempre requiere el botón de esta pantalla y Face ID; conectar el cable USB por sí solo nunca aprueba nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha este app em primeiro plano durante a autenticação. Se ele for para o segundo plano, a conexão é interrompida. A aprovação sempre exige o botão nesta tela e o Face ID; conectar o cabo USB por si só nunca aprova nada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증하는 동안 이 앱을 화면에 유지하세요. 앱이 백그라운드로 이동하면 연결이 중단됩니다. 승인은 항상 이 화면의 버튼과 Face ID가 필요하며, USB 케이블을 연결하는 것만으로는 절대 승인되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证期间请让此 App 保持在前台。如果它转入后台，连接将停止。批准始终需要点击此屏幕上的按钮并通过 Face ID；仅连接 USB 数据线绝不会批准任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證期間請讓此 App 保持在前景。如果它轉入背景，連線將停止。核准始終需要點擊此畫面上的按鈕並通過 Face ID；僅連接 USB 傳輸線絕不會核准任何操作。"
          }
        }
      }
    },
