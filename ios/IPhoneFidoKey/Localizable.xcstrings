    "pairing.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you delete it, every connection from the PC will be refused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると PC からの接続はすべて拒否されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie ihn löschen, werden alle Verbindungen vom PC abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous la supprimez, toutes les connexions depuis le PC seront refusées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la eliminas, se rechazarán todas las conexiones del PC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você a excluir, todas as conexões do PC serão recusadas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 PC의 모든 연결이 거부됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，来自 PC 的所有连接都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後，來自 PC 的所有連線都會被拒絕。"
          }
        }
      }
    },
