    "pairing.regenerate.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PC paired with the current key will no longer be able to connect. Enter the new key on the PC to pair again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のキーでペアリングした PC とは通信できなくなります。新しいキーを PC 側に入力し直してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein mit dem aktuellen Schlüssel gekoppelter PC kann sich dann nicht mehr verbinden. Geben Sie den neuen Schlüssel am PC erneut ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PC jumelé avec la clé actuelle ne pourra plus se connecter. Saisissez la nouvelle clé sur le PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PC emparejado con la clave actual ya no podrá conectarse. Introduce la nueva clave en el PC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um PC pareado com a chave atual não poderá mais se conectar. Digite a nova chave no PC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 키로 페어링된 PC는 더 이상 연결할 수 없습니다. PC에서 새 키를 다시 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前密钥配对的 PC 将无法再连接。请在 PC 上重新输入新密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前金鑰配對的 PC 將無法再連線。請在 PC 上重新輸入新金鑰。"
          }
        }
      }
    },
