<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements template for the ALTERNATIVE macOS packaging route:
  a signed .app / binary that creates the virtual HID device as a
  normal user, without root.

  This only works when the binary is signed with a provisioning
  profile from a PAID Apple Developer team that has been granted the
  restricted entitlement below. Ad-hoc signing (`codesign --sign -`)
  with this entitlement makes AMFI kill the binary at launch
  ("no eligible provisioning profiles"). See docs/MACOS.md.

  Usage (with a Developer ID / development profile in place):
    codesign --entitlements packaging/macos/phonefido.entitlements \
             --sign "Developer ID Application: ..." \
             target/release/iphone-fido
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.hid.virtual.device</key>
	<true/>
</dict>
</plist>
